TAVILY_API_KEY=
JINA_API_KEY=
MOLTSETS_API_KEY=
PARALLEL_API_KEY=
YOU_API_KEY=
LINKUP_API_KEY=
FIRECRAWL_API_KEY=
SERPER_API_KEY=
APIFY_API_KEY=
BROWSERBASE_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional: low/medium/high. "low" makes Gemini 3 and other reasoning models much faster.
LLM_REASONING_EFFORT=
# Self-serve sign-up page at /signup (off by default). Set SIGNUP_CODE to require an invite code.
SIGNUP_ENABLED=
SIGNUP_CODE=
SIGNUP_PER_HOUR=20
PORT=3000
MCP_PORT=3333
MCP_HOST=127.0.0.1
# MCP_AUTH_TOKEN=
# Public URL of this server (your ngrok URL). Written into /llms.txt and /install.sh.
# PUBLIC_URL=
# Per-user tokens file. If it exists, /mcp requires a token from it. Manage: npm run token -- create <name>
# OUTMATE_TOKENS_FILE=data/tokens.json

# Per-user provider keys through Nango (optional). Create one API-key integration per provider in
# Nango, with the integration id equal to the provider id: tavily, jina, moltsets, apollo, hunter.
# NANGO_SECRET_KEY=
# NANGO_HOST=https://api.nango.dev
# Fall back to the server's own keys above when a user has not added theirs (default true).
# OUTMATE_SHARED_KEYS=true
# Folder of tool files (default: tools/ in the repo).
# OUTMATE_TOOLS_DIR=
