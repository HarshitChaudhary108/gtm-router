{
  "name": "custom.prospeo_enrich_person",
  "tool": "prospeo_enrich_person",
  "order": 306,
  "kind": "http",
  "key": "prospeo",
  "category": "People & Contact Data",
  "needs_key": true,
  "capability": "find a work email (Prospeo)",
  "description": "Find someone's verified work email and details from first name, last name and company website (Prospeo).",
  "parameters": {
    "type": "object",
    "properties": {
      "first_name": {
        "type": "string",
        "description": "First name."
      },
      "last_name": {
        "type": "string",
        "description": "Last name."
      },
      "company_website": {
        "type": "string",
        "description": "Company website domain, e.g. intercom.com."
      }
    },
    "required": [
      "first_name",
      "last_name",
      "company_website"
    ],
    "additionalProperties": false
  },
  "request": {
    "method": "POST",
    "url": "https://api.prospeo.io/enrich-person",
    "body": {
      "data": {
        "first_name": "{first_name}",
        "last_name": "{last_name}",
        "company_website": "{company_website}"
      }
    },
    "auth": {
      "in": "header",
      "name": "X-KEY"
    }
  }
}
