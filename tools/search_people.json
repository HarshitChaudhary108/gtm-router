{
  "name": "outmate.search_people",
  "tool": "search_people",
  "order": 40,
  "kind": "builtin",
  "key": "moltsets",
  "needs_key": true,
  "capability": "people and title search (MoltSets)",
  "description": "Search MoltSets' B2B people database by name, title, company or domain, seniority, department, location, industry or company size. Returns title, seniority, LinkedIn URL, business email and company. Use for finding contacts at an account. At most one call per request.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Person name free-text search."
      },
      "title": {
        "type": "string",
        "description": "Job title match, e.g. Head of Marketing."
      },
      "company": {
        "type": "string",
        "description": "Company name."
      },
      "company_domain": {
        "type": "string",
        "description": "Exact company domain, e.g. vercel.com."
      },
      "city": {
        "type": "string",
        "description": "City name."
      },
      "seniority": {
        "type": "string",
        "description": "Seniority level, e.g. Manager, Director, VP."
      },
      "department": {
        "type": "string",
        "description": "Department. Do not combine with functional_area."
      },
      "functional_area": {
        "type": "string",
        "description": "Functional area. Do not combine with department."
      },
      "industry": {
        "type": "string",
        "enum": [
          "Professional and Business Services",
          "Information Technology",
          "Manufacturing",
          "Retail",
          "Health and Pharmaceuticals",
          "Creative Arts and Entertainment",
          "Construction",
          "Marketing & Advertising",
          "Finance and Banking",
          "Tourism and Hospitality",
          "Non-Profit and Social Services",
          "Food and Beverage",
          "Real Estate",
          "Education",
          "Transportation and Logistics",
          "Media and Publishing",
          "Energy",
          "Government and Public Administration",
          "Automotive",
          "Telecommunications",
          "Agriculture",
          "Utilities"
        ],
        "description": "Exact company industry bucket."
      },
      "employee_range": {
        "type": "string",
        "enum": [
          "1-10",
          "11-20",
          "21-50",
          "51-200",
          "201-500",
          "501-1000",
          "1001-5000",
          "5001+"
        ],
        "description": "Company employee count band."
      },
      "revenue_range": {
        "type": "string",
        "enum": [
          "Below $500k",
          "$500k - $1M",
          "$1M - $5M",
          "$5M - $10M",
          "$10M - $20M",
          "$20M - $50M",
          "Above $50M"
        ],
        "description": "Company revenue band."
      },
      "naics_code": {
        "type": "string",
        "description": "2-6 digit NAICS code."
      },
      "linkedin_industry": {
        "type": "string",
        "description": "Exact LinkedIn industry label."
      },
      "country": {
        "type": "string",
        "description": "Full English country name."
      },
      "state": {
        "type": "string",
        "description": "Full state/region name or abbreviation."
      },
      "exclude_company_domain": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 25
      },
      "exclude_country": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 25
      },
      "exclude_state": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 25
      },
      "exclude_industry": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 25
      },
      "exclude_seniority": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 25
      },
      "exclude_employee_range": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "1-10",
            "11-20",
            "21-50",
            "51-200",
            "201-500",
            "501-1000",
            "1001-5000",
            "5001+"
          ]
        },
        "maxItems": 25
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "description": "Results per page. Defaults to 10; maximum 10."
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000,
        "description": "Results to skip for pagination."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
