{
  "name": "outmate.apollo_people",
  "tool": "apollo_people",
  "order": 60,
  "kind": "builtin",
  "key": "apollo",
  "category": "People & Contact Data",
  "needs_key": true,
  "capability": "people search (Apollo)",
  "description": "Search Apollo's B2B people database by keyword, title, seniority, location or company domain. Returns name, title, seniority, location, LinkedIn URL and company. Apollo search does not return email addresses; use Hunter for emails.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Person name or keyword."
      },
      "title": {
        "type": "string",
        "description": "Job title, e.g. Head of Marketing."
      },
      "seniority": {
        "type": "string",
        "description": "Seniority level, e.g. director, vp, c_suite."
      },
      "location": {
        "type": "string",
        "description": "Person location, e.g. United States."
      },
      "company_domain": {
        "type": "string",
        "description": "Company domain, e.g. vercel.com."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "description": "Results per page. Defaults to 10."
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "description": "Page number. Defaults to 1."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
